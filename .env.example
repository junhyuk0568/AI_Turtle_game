ANTHROPIC_API_KEY=
GAME_CLAUDE_MODEL=claude-sonnet-5-5
GAME_CLAUDE_EFFORT=low
GAME_CLAUDE_TIMEOUT_SECONDS=60
GAME_CLAUDE_MAX_RETRIES=2
GAME_CLAUDE_REFUSAL_FALLBACK=True
GAME_CLAUDE_QUESTION_MAX_TOKENS=4000
GAME_CLAUDE_FINAL_ANSWER_MAX_TOKENS=4000
GAME_CLAUDE_CRITERIA_MAX_TOKENS=16000
GAME_QUESTION_HISTORY_LIMIT=8
GAME_AI_CALLS_PER_MINUTE=10
GAME_MAX_QUESTIONS_PER_GAME=100
# Daily billed calls (questions + final answers) per account / per guest session; 0 = no cap.
GAME_DAILY_AI_CALLS_PER_ACCOUNT=300
GAME_DAILY_AI_CALLS_PER_GUEST=50
# Stop player calls once today's estimated Claude spend reaches this (USD); 0 = no stop.
GAME_DAILY_AI_BUDGET_USD=5

# Google login (OAuth client from Google Cloud Console). Leave empty to hide the login button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DJANGO_SECRET_KEY=replace-this-for-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
GAME_LOG_LEVEL=INFO
